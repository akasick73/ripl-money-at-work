(function(){const scenes=document.querySelectorAll('.v27-scene');let busy=false;function update(){busy=false;for(const section of scenes){const frame=section.querySelector('iframe');if(!frame||!frame.contentWindow)continue;const r=section.getBoundingClientRect();const span=Math.max(1,r.height-innerHeight);const progress=Math.max(0,Math.min(1,-r.top/span));try{frame.contentWindow.postMessage({type:'riplSceneProgress',progress},'*')}catch(e){}}}function tick(){if(!busy){busy=true;requestAnimationFrame(update)}}addEventListener('scroll',tick,{passive:true});addEventListener('resize',tick);document.querySelectorAll('.v27-scene iframe').forEach(f=>f.addEventListener('load',tick));tick()})();
</script></body></html>
